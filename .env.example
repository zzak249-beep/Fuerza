# ===== Telegram (obligatorio para recibir avisos) =====
# 1) En Telegram habla con @BotFather -> /newbot -> copia el token aquí
# 2) Escribe /start a tu bot y ejecuta:  python bot.py --get-chat-id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Qué escanear =====
TIMEFRAMES=15m,5m
QUOTE_ASSETS=USDT
# Ignora contratos con poco volumen 24h (en USDT). 0 = escanear todos
MIN_VOLUME_24H_USDT=2000000
# Filtros opcionales por nombre (expresión regular), p. ej. EXCLUDE_REGEX=^(1000|NCS)
INCLUDE_REGEX=
EXCLUDE_REGEX=

# ===== Tu cuenta (solo para sugerir tamaño de posición) =====
ACCOUNT_USDT=1000
RISK_PCT=1.0
MAX_LEV=3

# ===== Señales =====
SIGNAL_TYPES=G1,G3,G4,G5,G7,G8
DIRECTION=both
# Timeframe superior por cada timeframe de escaneo (BingX no tiene 3h)
HTF_MAP=5m:1h,15m:4h

# ===== Ajuste fino (valores por defecto = indicador de TradingView) =====
# REGIME_MODE=ER        # ER | ADX | ER+ADX
# ER_MIN=0.25
# USE_DELTA=1
# USE_PREV_DAY=0
# COST_MULT=5
# RATE_LIMIT_RPS=8
